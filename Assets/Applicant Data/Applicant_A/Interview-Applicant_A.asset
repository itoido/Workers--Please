  m_Script: {fileID: 11500000, guid: 86ed98875aec808459d9bb7227a98a35, type: 3}
  m_Name: Interview-Applicant_A
  m_EditorClassIdentifier: 
  interviewDate: 2026-10-17
  interviewerName: Toshihiro Nifuji
  questions:
  - question: "\u7C21\u5358\u306B\u81EA\u5DF1\u7D39\u4ECB\u3068\u3001\u5F0A\u793E\u3092\u5FD7\u671B\u3055\u308C\u305F\u7406\u7531\u3092\u304A\u805E\u304B\u305B\u304F\u3060\u3055\u3044\u3002"
    answer: "Toshihiro Nifuji\u300130\u6B73\u3067\u3059\u30022017\u5E74\u306B\u6771\u592E\u5927\u5B66\u60C5\u5831\u5DE5\u5B66\u90E8\u3092\u5352\u696D\u5F8C\u3001\u682A\u5F0F\u4F1A\u793E\u30A2\u30B9\u30C6\u30EB\u30B0\u30EA\u30C3\u30C9\u30675\u5E74\u307B\u3069\u30B5\u30FC\u30D0\u30FC\u30B5\u30A4\u30C9\u30A8\u30F3\u30B8\u30CB\u30A2\u3068\u3057\u3066\u50CD\u304D\u3001\u305D\u306E\u5F8C\u30CE\u30FC\u30B9\u30E9\u30A4\u30F3\u30B7\u30B9\u30C6\u30E0\u30BA\u5408\u540C\u4F1A\u793E\u30673\u5E74\u9593\u30D0\u30C3\u30AF\u30A8\u30F3\u30C9\u30A8\u30F3\u30B8\u30CB\u30A2\u3092\u52D9\u3081\u307E\u3057\u305F\u3002\u6628\u5E743\u6708\u304B\u3089\u306F\u500B\u4EBA\u4E8B\u696D\u3068\u3057\u3066\u696D\u52D9\u59D4\u8A17\u958B\u767A\u3092\u53D7\u3051\u3066\u3044\u307E\u3059\u3002\r\n\r\n\u5F97\u610F\u3068\u3057\u3066\u3044\u308B\u306E\u306F\u3001\u5927\u898F\u6A21\u306A\u4E88\u7D04\u30B7\u30B9\u30C6\u30E0\u306E\u5206\u5272\u3068\u3001\u969C\u5BB3\u306E\u5C11\u306A\u3044\u30C7\u30FC\u30BF\u57FA\u76E4\u3065\u304F\u308A\u3067\u3059\u3002\u76F4\u8FD1\u3067\u306FBitHug\u3067
      harbor-reserve-api \u3068\u3044\u3046\u4E88\u7D04\u53D7\u4ED8\u3068\u901A\u77E5\u51E6\u7406\u3092\u5206\u3051\u305F\u30D0\u30C3\u30AF\u30A8\u30F3\u30C9\u306E\u30B5\u30F3\u30D7\u30EB\u3092\u516C\u958B\u3057\u3066\u304A\u308A\u3001idempotency
      key\u306B\u3088\u308B\u91CD\u8907\u9632\u6B62\u3084outbox\u30D1\u30BF\u30FC\u30F3\u3067\u306E\u975E\u540C\u671F\u901A\u77E5\u306A\u3069\u3092\u5B9F\u88C5\u3057\u3066\u3044\u307E\u3059\u3002\r\n\r\n\u5F0A\u793E\u3092\u5FD7\u671B\u3057\u305F\u306E\u306F\u3001\u8CB4\u793E\u304C\u6271\u3063\u3066\u3044\u308B\u4E88\u7D04\u30FB\u6C7A\u6E08\u5468\u308A\u306E\u30D7\u30ED\u30C0\u30AF\u30C8\u898F\u6A21\u3068\u3001\u6280\u8853\u7684\u306A\u8AB2\u984C\u611F\u304C\u81EA\u5206\u306E\u7D4C\u9A13\u3068\u5408\u81F4\u3059\u308B\u3068\u611F\u3058\u305F\u305F\u3081\u3067\u3059\u3002\u30D5\u30EB\u30EA\u30E2\u30FC\u30C8\u3067\u3001\u5E73\u65E5\u65E5\u4E2D\u306F\u5B89\u5B9A\u3057\u3066\u7A3C\u50CD\u3067\u304D\u308B\u74B0\u5883\u3082\u6574\u3063\u3066\u3044\u307E\u3059\u3002"
  - question: "\u30CE\u30FC\u30B9\u30E9\u30A4\u30F3\u30B7\u30B9\u30C6\u30E0\u30BA\u3067\u306F3\u5E74\u9593\u3068\u306E\u3053\u3068\u3067\u3059\u304C\u3001\u3053\u3061\u3089\u3067\u306F\u3069\u306E\u3088\u3046\u306A\u696D\u52D9\u3092\uFF1F\u307E\u305F\u3001\u500B\u4EBA\u4E8B\u696D\u306B\u79FB\u3089\u308C\u305F\u7D4C\u7DEF\u3082\u5408\u308F\u305B\u3066\u304A\u805E\u304D\u3057\u305F\u3044\u3067\u3059\u3002"
    answer: "\u8907\u6570\u306E\u30AF\u30E9\u30A4\u30A2\u30F3\u30C8\u6848\u4EF6\u3092\u4E26\u884C\u3057\u3066\u62C5\u5F53\u3059\u308B\u53D7\u8A17\u958B\u767A\u306E\u30D0\u30C3\u30AF\u30A8\u30F3\u30C9\u30A8\u30F3\u30B8\u30CB\u30A2\u3068\u3057\u3066\u50CD\u3044\u3066\u3044\u307E\u3057\u305F\u3002\u4E3B\u306BPython\u3068Go\u3067\u3001EC\u30B5\u30A4\u30C8\u306E\u6C7A\u6E08\u5468\u308A\u3084\u3001\u793E\u5185\u7BA1\u7406\u30B7\u30B9\u30C6\u30E0\u306EAPI\u57FA\u76E4\u69CB\u7BC9\u306A\u3069\u3092\u624B\u304C\u3051\u3066\u3044\u307E\u3059\u3002\r\n\r\n\u500B\u4EBA\u4E8B\u696D\u306B\u79FB\u3063\u305F\u306E\u306F\u3001\u3088\u308A\u81EA\u5206\u306E\u88C1\u91CF\u3067\u6280\u8853\u9078\u5B9A\u304B\u3089\u904B\u7528\u307E\u3067\u4E00\u8CAB\u3057\u3066\u95A2\u308F\u308A\u305F\u3044\u3068\u601D\u3063\u305F\u306E\u3068\u3001\u30D5\u30EB\u30EA\u30E2\u30FC\u30C8\u3067\u50CD\u304D\u306A\u304C\u3089\u8907\u6570\u306E\u30D7\u30ED\u30B8\u30A7\u30AF\u30C8\u306B\u95A2\u308F\u308B\u30B9\u30BF\u30A4\u30EB\u3092\u8A66\u3057\u305F\u304B\u3063\u305F\u305F\u3081\u3067\u3059\u3002\u3053\u306E1\u5E74\u534A\u3067\u3001\u30B9\u30BF\u30FC\u30C8\u30A2\u30C3\u30D72\u793E\u306E\u30D0\u30C3\u30AF\u30A8\u30F3\u30C9\u57FA\u76E4\u69CB\u7BC9\u3068\u3001\u65E2\u5B58\u30B7\u30B9\u30C6\u30E0\u306E\u30EA\u30D5\u30A1\u30AF\u30BF\u30EA\u30F3\u30B0\u6848\u4EF6\u30921\u4EF6\u62C5\u5F53\u3057\u307E\u3057\u305F\u3002"
  - question: "BitHug\u3067\u516C\u958B\u3055\u308C\u3066\u3044\u308B harbor-reserve-api
      \u306B\u3064\u3044\u3066\u3001\u3082\u3046\u5C11\u3057\u8A73\u3057\u304F\u304A\u805E\u304D\u3057\u305F\u3044\u3067\u3059\u3002README\u306B\u300C\u8A2D\u8A08\u3068\u5B9F\u88C5\u306F\u79C1\u4E00\u4EBA\u3067\u62C5\u5F53\u3057\u307E\u3057\u305F\u300D\u3068\u3042\u308A\u307E\u3059\u304C\u3001\u3053\u306E\u30EA\u30DD\u30B8\u30C8\u30EA\u3092\u4F5C\u3063\u305F\u304D\u3063\u304B\u3051\u3068\u3001\u7279\u306B\u82E6\u52B4\u3057\u305F\u30DD\u30A4\u30F3\u30C8\u3092\u6559\u3048\u3066\u304F\u3060\u3055\u3044\u3002"
    answer: "\u3053\u308C\u306F\u3001\u904E\u53BB\u306B\u696D\u52D9\u3067\u6271\u3063\u305F\u4E88\u7D04\u30B7\u30B9\u30C6\u30E0\u306E\u5206\u5272\u30D1\u30BF\u30FC\u30F3\u3092\u3001\u6C4E\u7528\u7684\u306A\u30B5\u30F3\u30D7\u30EB\u3068\u3057\u3066\u6574\u7406\u3057\u76F4\u3057\u305F\u3082\u306E\u3067\u3059\u3002\u30A2\u30B9\u30C6\u30EB\u30B0\u30EA\u30C3\u30C9\u6642\u4EE3\u306E\u7D4C\u9A13\u3068\u3001\u30CE\u30FC\u30B9\u30E9\u30A4\u30F3\u3067\u306E\u53D7\u8A17\u6848\u4EF6\u3067\u5F97\u305F\u77E5\u898B\u3092\u5408\u308F\u305B\u3066\u3001\u300C\u4E88\u7D04\u53D7\u4ED8\u3068\u901A\u77E5\u3092\u3069\u3046\u5206\u3051\u308B\u304B\u300D\u3068\u3044\u3046\u3088\u304F\u3042\u308B\u8AB2\u984C\u306B\u5BFE\u3059\u308B\u4E00\u3064\u306E\u89E3\u7B54\u4F8B\u3068\u3057\u3066\u307E\u3068\u3081\u307E\u3057\u305F\u3002\r\n\r\n\u82E6\u52B4\u3057\u305F\u306E\u306F\u3001idempotency
      key\u306E\u8A2D\u8A08\u3067\u3059\u3002\u540C\u4E00\u30EA\u30AF\u30A8\u30B9\u30C8\u306E\u518D\u9001\u3092\u3069\u3046\u6271\u3046\u304B\u3001\u51AA\u7B49\u6027\u3092\u3069\u3053\u307E\u3067\u4FDD\u8A3C\u3059\u308B\u304B\u3067\u3001\u30C7\u30FC\u30BF\u30D9\u30FC\u30B9\u306E\u30E6\u30CB\u30FC\u30AF\u5236\u7D04\u3068\u30A2\u30D7\u30EA\u30B1\u30FC\u30B7\u30E7\u30F3\u5074\u306E\u691C\u8A3C\u306E\u30D0\u30E9\u30F3\u30B9\u3092\u53D6\u308B\u306E\u306B\u8A66\u884C\u932F\u8AA4\u3057\u307E\u3057\u305F\u3002\u307E\u305F\u3001outbox\u30D1\u30BF\u30FC\u30F3\u3067\u306E\u901A\u77E5\u51E6\u7406\u306B\u3064\u3044\u3066\u3001\u30EF\u30FC\u30AB\u30FC\u306E\u30EA\u30C8\u30E9\u30A4\u6226\u7565\u3084\u3001\u901A\u77E5\u5931\u6557\u6642\u306E\u88DC\u511F\u30C8\u30E9\u30F3\u30B6\u30AF\u30B7\u30E7\u30F3\u3092\u3069\u3046\u8A2D\u8A08\u3059\u308B\u304B\u3082\u60A9\u307F\u3069\u3053\u308D\u3067\u3057\u305F\u3002\r\n\r\n\u8CA0\u8377\u8A66\u9A13\u3067\u306F\u3001\u4E88\u7D04\u78BA\u5B9AAPI\u306Ep95\u3092820ms\u304B\u3089240ms\u307E\u3067\u77ED\u7E2E\u3067\u304D\u3066\u304A\u308A\u3001\u3053\u306E\u3042\u305F\u308A\u306E\u6570\u5024\u306F\u81EA\u4FE1\u3092\u6301\u3063\u3066\u51FA\u305B\u308B\u3082\u306E\u3067\u3059\u3002"
