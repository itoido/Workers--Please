  m_Script: {fileID: 11500000, guid: 86ed98875aec808459d9bb7227a98a35, type: 3}
  m_Name: Interview-Applicant_C
  m_EditorClassIdentifier: 
  interviewDate: 2026-09-19
  interviewerName: Akira Kanbara
  questions:
  - question: "\u4EE3\u8868\u30EA\u30DD\u30B8\u30C8\u30EA\u306E\u62C5\u5F53\u7BC4\u56F2\u306F\u3069\u3053\u3067\u3059\u304B\uFF1F"
    answer: "steady-metrics-exporter \u306F2024\u5E741\u6708\u304B\u30896\u6708\u307E\u3067\u500B\u4EBA\u3067\u8A2D\u8A08\u30FB\u5B9F\u88C5\u3057\u305FGo\u88FD\u306EPrometheus
      exporter\u3067\u3059\u3002AWS\u306E\u30E1\u30C8\u30EA\u30AF\u30B9\u53D6\u5F97\u3001\u8A2D\u5B9A\u306ETerraform\u5316\u3001\u30A8\u30E9\u30FC\u6642\u306E\u30EA\u30C8\u30E9\u30A4\u3068\u30C6\u30B9\u30C8\u3092\u62C5\u5F53\u3057\u307E\u3057\u305F\u3002\u793E\u5185\u30B5\u30FC\u30D3\u30B9\u3078\u306E\u5C0E\u5165\u306F\u30B9\u30C6\u30C7\u30A3\u30EC\u30FC\u30F3\u306E\u904B\u7528\u30C1\u30FC\u30E0\u304C\u884C\u3044\u307E\u3057\u305F\u3002"
  - question: "\u8077\u6B74\u3068\u306E\u95A2\u4FC2\u3092\u6559\u3048\u3066\u304F\u3060\u3055\u3044\u3002"
    answer: "\u30AA\u30EB\u30D3\u30C3\u30C8\u30E9\u30C3\u30AF\u3067\u306FLinux\u76E3\u8996\u3068\u969C\u5BB3\u5BFE\u5FDC\u3001\u30AF\u30E9\u30A6\u30C9\u30CD\u30B9\u30C8\u30EF\u30FC\u30AF\u30B9\u3067\u306FAWS\u79FB\u884C\u3068Kubernetes\u904B\u7528\u3001\u73FE\u5728\u306E\u30B9\u30C6\u30C7\u30A3\u30EC\u30FC\u30F3\u3067\u306FSLO\u3068\u30A2\u30E9\u30FC\u30C8\u8A2D\u8A08\u3092\u62C5\u5F53\u3057\u3066\u3044\u307E\u3059\u3002\u8A18\u4E8B\u306B\u66F8\u3044\u305F\u300C\u4E00\u6B21\u5BFE\u5FDC\u3068\u958B\u767A\u30C1\u30FC\u30E0\u306E\u901A\u77E5\u3092\u5206\u3051\u3001\u591C\u9593\u306E\u4E0D\u8981\u306A\u30DA\u30FC\u30B8\u3092\u6E1B\u3089\u3057\u305F\u300D\u6539\u5584\u306F\u73FE\u5728\u306E\u30C1\u30FC\u30E0\u3067\u306E\u4ED5\u4E8B\u3067\u3059\u3002"
  - question: "\u30D5\u30EB\u30EA\u30E2\u30FC\u30C8\u306E\u7A3C\u50CD\u6761\u4EF6\u306F\uFF1F"
    answer: "\u5927\u962A\u304B\u3089\u5E73\u65E59\u6642\u304B\u308918\u6642\uFF08\u65E5\u672C\u6642\u9593\uFF09\u306B\u7A3C\u50CD\u3067\u304D\u307E\u3059\u3002\u67081\u56DE\u7A0B\u5EA6\u306E\u51FA\u793E\u3084\u30AA\u30F3\u30B5\u30A4\u30C8\u306E\u76F8\u8AC7\u306B\u306F\u4E8B\u524D\u8ABF\u6574\u3067\u5BFE\u5FDC\u3057\u307E\u3059\u3002"
